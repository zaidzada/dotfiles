# -----------------------------------------------------------------------------
# > Functions
# -----------------------------------------------------------------------------

mkd() {
  mkdir -p "$@" && cd "$@" || return
}

lc() {
  column -s',' -t "$@" | less -S
}

# broken symlink finder
lnb() {
    find . -type l ! -exec test -e {} \; -print
}

function cd() {
  if [ "$#" -eq 0 ]; then
    builtin cd
    return
  fi

  if [ -f "$1" ]; then
    builtin cd -- "$(dirname -- "$1")" || return
  else
    builtin cd -- "$1" || return
  fi
}

bkp() {
  cp "$1" "$(date +%Y%m%d_%s_)$1"
}

recipe() {
    pandoc -f html -t markdown_strict-escaped_line_breaks "https://www.plainoldrecipe.com/recipe?url=$1"
}
