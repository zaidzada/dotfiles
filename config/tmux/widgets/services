#!/usr/bin/env zsh
# Background services: brew services on macOS, systemd units on Linux.
# refresh: 30
#
# On Linux it lists every running user service, and for user and system
# units alike, any that failed (in red) and those in $SERVICES_UNITS with
# their state. System services are only counted otherwise; most are the
# distro's own. $SERVICES_UNITS is space separated, with user: before a user
# unit, e.g. "sshd nginx user:syncthing". Set it with split-window -e.

green=$'\e[32m' red=$'\e[31m' dim=$'\e[2m' off=$'\e[0m'

# Color a state: running ones green, failed ones red, idle ones dim
paint() {
    case $1 in
        started|active|running) print -rn -- $green$1$off ;;
        error|failed) print -rn -- $red$1$off ;;
        *) print -rn -- $dim$1$off ;;
    esac
}

if [[ $OSTYPE == darwin* ]]; then
    (( $+commands[brew] )) || { print 'brew not installed'; exit }
    out=(${(f)"$(brew services list 2>/dev/null)"})
    (( $#out > 1 )) || { print 'no brew services'; exit }
    printf '%-24s %-10s %s\n' SERVICE STATUS USER
    for line in $out[2,-1]; do
        f=(${=line})
        printf '%-24s %s %s\n' $f[1] "$(paint $f[2])${(l:10-${#f[2]}:: :)}" "${f[3]-}"
    done
    exit
fi

(( $+commands[systemctl] )) || { print 'systemd not found'; exit }

# Units of a scope (system or user) in a state, as name and description.
# Failed covers every unit type; .service is dropped from names
units() {
    local -a type=(--type=service)
    [[ $2 == failed ]] && type=()
    systemctl --$1 list-units $type --state=$2 --no-legend --plain 2>/dev/null |
        awk '{
            name = $1; sub(/\.service$/, "", name)
            desc = ""; for (i = 5; i <= NF; i++) desc = desc (i > 5 ? " " : "") $i
            print name "\t" desc
        }'
}

# name, then a state if any, then a dim description if any
row() { printf '  %-28s %s\n' $1 "${2:+$2 }${3:+$dim$3$off}" }

# Watched units by scope; user: ones are user units
watched_user=(${${(M)${=SERVICES_UNITS-}:#user:*}#user:})
watched_system=(${${=SERVICES_UNITS-}:#user:*})

for scope in user system; do
    failed=(${(f)"$(units $scope failed)"})
    running=(${(f)"$(units $scope running)"})
    watched=(${(P)${:-watched_$scope}})
    print -r -- "$scope ${dim}· $#running running, $#failed failed$off"
    for line in $failed; row ${line%%$'\t'*} "$(paint failed)" ${line#*$'\t'}
    for unit in $watched; do
        state=$(systemctl --$scope is-active $unit 2>/dev/null)
        row ${unit%.service} "$(paint ${state:-unknown})"
    done
    # Every running user service; system ones are mostly the distro's own,
    # so only the watched ones are shown
    if [[ $scope == user ]]; then
        for line in $running; do
            (( ${watched[(Ie)${line%%$'\t'*}]} )) ||
                row ${line%%$'\t'*} '' ${line#*$'\t'}
        done
    fi
    print
done
