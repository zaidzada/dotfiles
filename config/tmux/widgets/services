#!/usr/bin/env zsh
# Background services: brew services on macOS, systemd units on Linux.
# refresh: 30
#
# On Linux it shows how many system and user services run and which units
# failed, then the state of each unit in $SERVICES_UNITS (space separated;
# prefix user: for a user unit, e.g. "sshd nginx user:syncthing"). Set it
# with split-window -e.

green=$'\e[32m' red=$'\e[31m' dim=$'\e[2m' off=$'\e[0m'

# Color a state: running ones green, failed ones red, idle ones dim
paint() {
    case $1 in
        started|active|running) print -rn -- $green$1$off ;;
        error|failed) print -rn -- $red$1$off ;;
        *) print -rn -- $dim$1$off ;;
    esac
}

if [[ $OSTYPE == darwin* ]]; then
    (( $+commands[brew] )) || { print 'brew not installed'; exit }
    out=(${(f)"$(brew services list 2>/dev/null)"})
    (( $#out > 1 )) || { print 'no brew services'; exit }
    printf '%-24s %-10s %s\n' SERVICE STATUS USER
    for line in $out[2,-1]; do
        f=(${=line})
        printf '%-24s %s %s\n' $f[1] "$(paint $f[2])${(l:10-${#f[2]}:: :)}" "${f[3]-}"
    done
    exit
fi

(( $+commands[systemctl] )) || { print 'systemd not found'; exit }

for scope in system user; do
    flag=--$scope
    running=$(systemctl $flag list-units --type=service --state=running \
        --no-legend --plain 2>/dev/null | wc -l)
    failed=(${(f)"$(systemctl $flag list-units --state=failed --no-legend \
        --plain 2>/dev/null | awk '{print $1}')"})
    printf '%-7s %s running, %s failed\n' $scope $green${running// /}$off \
        "$( (( $#failed )) && print -rn -- $red$#failed$off || print -rn 0)"
    for unit in $failed; printf '  %s %s\n' $unit "$(paint failed)"
done

if [[ -n ${SERVICES_UNITS-} ]]; then
    print
    for unit in ${=SERVICES_UNITS}; do
        if [[ $unit == user:* ]]; then
            state=$(systemctl --user is-active ${unit#user:} 2>/dev/null)
        else
            state=$(systemctl is-active $unit 2>/dev/null)
        fi
        printf '%-24s %s\n' $unit "$(paint ${state:-unknown})"
    done
fi
