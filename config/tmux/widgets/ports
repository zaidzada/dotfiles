#!/usr/bin/env zsh
# Listening TCP ports with their address and process.
# refresh: 10

# Rows of port, address, process (pid)
if [[ $OSTYPE == darwin* ]]; then
    rows=$(lsof -nP -iTCP -sTCP:LISTEN -F pcn 2>/dev/null | awk '
        /^p/ {pid = substr($0, 2)}
        /^c/ {cmd = substr($0, 2)}
        /^n/ {
            addr = port = substr($0, 2)
            sub(/:[^:]*$/, "", addr); sub(/.*:/, "", port)
            print port "\t" addr "\t" cmd " (" pid ")"
        }')
    # lsof only sees other users' processes as root
    (( EUID )) && note='only your processes; root sees all'
else
    rows=$(ss -Hltnp 2>/dev/null | awk '{
        addr = port = $4
        sub(/:[^:]*$/, "", addr); sub(/.*:/, "", port)
        proc = "-"
        if (match($0, /users:\(\("[^"]*",pid=[0-9]+/)) {
            split(substr($0, RSTART + 9, RLENGTH - 9), p, "\",pid=")
            proc = p[1] " (" p[2] ")"
        }
        print port "\t" addr "\t" proc
    }')
    (( EUID )) && note="other users' processes show as -"
fi

if [[ -z $rows ]]; then
    print 'no listening TCP ports'
else
    # The same socket is often listed once for IPv4 and once for IPv6
    print -r -- $rows | sort -u | sort -t$'\t' -k1,1n -k2,2 |
        awk -F'\t' 'BEGIN {printf "%-6s %-22s %s\n", "PORT", "ADDRESS", "PROCESS"}
                   {printf "%-6s %-22s %s\n", $1, $2, $3}'
fi
[[ -n $note ]] && print -r -- $'\e[2m'"($note)"$'\e[22m'
