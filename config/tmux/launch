#!/usr/bin/env zsh
# App launcher: open a layout of panes running preset commands (a system
# monitor, an editor with a test watcher, ...) described by a zsh script in
# ~/.config/tmux/layouts. prefix d shows a picker of layouts (launcher.zsh).
#
# usage: launch [-s | -w | -f] <layout>  open in a session, window or float
#        launch -l                       list layouts
#        (-t pane -c client: act for that pane and client, used by the picker)
#
# Window (the default) adds the layout as a window in the current session.
# Session makes a session named after the layout. Float shows that same
# session in a floating pane over the current window; it takes all keys, so
# prefix D closes it (or a click outside, with the mouse on). Both leave the
# session running, so reopening one is instant.
#
# A layout is sourced once its window exists. Its first line is a
# "# description" for the picker. It builds the window with these functions,
# named after the tmux commands they wrap:
#   split-window [-T title] [-t title] [flags] <cmd>
#       a pane running cmd. The first call fills the window's starting pane
#       and later ones split beside the previous pane, or beside the pane
#       titled with -t. Other flags go to tmux split-window (-h, -v, -b, -f,
#       -l size, -c dir, -e var=val). Panes made without flags are tiled
#   select-layout <name>
#       any select-layout argument: even-horizontal, main-vertical, tiled, ...
#       or a custom string copied from: tmux display -p '#{window_layout}'
#   widget <name> [-n secs] [split-window flags]
#       a pane titled name that reruns ../widgets/<name> every secs (default
#       the widget's "# refresh: N" line, else 10). A widget is a script that
#       prints a snapshot and exits; set its variables with -e var=val
#   set-option <opt> <val>
#       a window option, e.g. pane-border-status top
# Everything else is plain zsh, so a layout can branch on $OSTYPE, check
# $+commands[htop], or call tmux itself ($win is the window). The first pane
# gets focus.

dir=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/layouts
widget_dir=${dir:h}/widgets

die() { print -ru2 -- "launch: $*"; exit 1 }

layouts() { print -rl -- $dir/*(N.:t) }

usage() {
    print -u2 'usage: launch [-s | -w | -f] <layout>\n       launch -l'
    exit 2
}

# Layout functions. State: the window, its first pane, the last pane made,
# pane ids by title, and whether any pane was placed by hand or a layout set
split-window() {
    local title= target=$prev pane
    local -a args
    while (( $# )); do
        case $1 in
            -T) title=$2; shift 2 ;;
            -t) [[ -n ${panes[$2]-} ]] || die "split-window: no pane titled '$2'"
                target=$panes[$2]; shift 2 ;;
            -[lceF]) args+=($1 $2); shift 2 ;;
            --) shift; break ;;
            -*) args+=($1); shift ;;
            *) break ;;
        esac
    done
    (( $# )) || die "split-window: no command"
    if [[ -z $prev ]]; then
        pane=$first
        tmux respawn-pane -k -t $pane "$@" || exit 1
    else
        if (( $#args )) || [[ $target != $prev ]]; then manual=1; fi
        pane=$(tmux split-window -d -P -F '#{pane_id}' -t $target $args "$@") ||
            exit 1
        # Re-tile as we go so many panes don't run out of room
        (( manual )) || tmux select-layout -t $win tiled
    fi
    prev=$pane
    if [[ -n $title ]]; then
        tmux select-pane -t $pane -T $title
        panes[$title]=$pane
    fi
}

widget() {
    local name=$1 file=$widget_dir/${1-} secs=
    local -a args
    [[ -n $name && -x $file ]] || die "widget: no widget '$name'"
    shift
    while (( $# )); do
        if [[ $1 == -n ]]; then secs=$2; shift 2; else args+=($1); shift; fi
    done
    [[ -n $secs ]] ||
        secs=${${(M)${(f)"$(<$file)"}:#\# refresh: *}#\# refresh: }
    # -c keeps the widget's colors
    split-window -T $name $args "watch -c -t -n ${secs:-10} ${(q)file}"
}

select-layout() { tmux select-layout -t $win "$@" && laidout=1 }

set-option() { tmux set-option -w -t $win "$@" }

# Build layout $1 in window $2, whose only pane is $3. Run in a subshell so
# the layout's variables can't clobber ours
fill() {
    win=$2 first=$3 prev= manual=0 laidout=0
    typeset -A panes
    # Keep panes whose command fails, to show why. Set on the window so new
    # panes have it from the start, even one that fails immediately
    tmux set -w -t $win remain-on-exit failed
    source $1
    [[ -n $prev ]] || die "${1:t} has no panes"
    (( manual || laidout )) || tmux select-layout -t $win tiled
    tmux select-pane -t $first
}

# Make the session $1 unless it already exists, sized like the caller's
# window so the layout starts at the right proportions
ensure_session() {
    local -a size ids
    tmux has-session -t "=$1" 2>/dev/null && return
    if [[ -n $here ]]; then
        size=(${=$(tmux display -p -t $here '#{window_width} #{window_height}')})
    else
        size=($(tput cols) $(tput lines))
    fi
    ids=(${=$(tmux new-session -d -s $1 -n $1 -x $size[1] -y $size[2] \
        -P -F '#{window_id} #{pane_id}')}) || exit 1
    ( fill $dir/$1 $ids ) || exit 1
}

# The pane and client to act on: given by the picker, else the pane this
# runs in
mode=w here=${TMUX_PANE:-} client=
while getopts swflt:c: opt; do
    case $opt in
        [swf]) mode=$opt ;;
        t) here=$OPTARG ;;
        c) client=$OPTARG ;;
        l) layouts; exit ;;
        *) usage ;;
    esac
done
shift $(( OPTIND - 1 ))
(( $# == 1 )) || usage
name=$1
[[ -f $dir/$name ]] || die "no layout '$name' (have: ${(f)$(layouts)})"
[[ $mode == s || -n $here ]] || die "-$mode only works inside tmux"

case $mode in
    w)
        ids=(${=$(tmux new-window -t "$(tmux display -p -t $here '#{session_id}'):" \
            -n $name -P -F '#{window_id} #{pane_id}')}) || exit 1
        ( fill $dir/$name $ids ) || exit 1
        ;;
    s)
        ensure_session $name
        if [[ -n $here ]]; then
            tmux switch-client ${client:+-c} ${client:+$client} -t "=$name"
        else
            exec tmux attach -t "=$name"
        fi
        ;;
    f)
        [[ "$(tmux display -p -t $here '#S')" != $name ]] ||
            die "already in session $name"
        ensure_session $name
        # Attach to this server even if it isn't the default one
        sock=$(tmux display -p '#{socket_path}')
        tmux new-pane -t $here -O -K -C -x90% -y90% -X5% -Y5% \
            "TMUX= tmux -S '$sock' attach -t '=$name'"
        ;;
esac
