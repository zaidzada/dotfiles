# System monitor: info and a scratch pad on the left; htop, disk and io on the right.
#
# A layout file lists one pane per line, in the order they're created; the
# first one gets focus. A line is a shell command, optionally prefixed with a
# pane title and " | ". Other lines:
#   layout <name>   any select-layout argument: even-horizontal,
#                   even-vertical, main-horizontal, main-vertical, tiled, or a
#                   custom string copied from: tmux display -p '#{window_layout}'
#   split <flags>   split-window flags for the next pane (-h, -v, -b, -f,
#                   -l size), placing it beside the previous pane, or beside
#                   the pane titled <title> with -t <title>. Panes without a
#                   split line are tiled unless a split line came before
#   set <opt> <val> a window option for the layout, e.g. main-pane-width
# Blank lines and # comments are skipped.

set pane-border-status top
set pane-border-format " #{pane_title} "

# One notes file per tmux session (the one this pane is in), saved on every
# change so notes survive the session being killed
notes | f=${XDG_DATA_HOME:-$HOME/.local/share}/scratchpad/$(tmux display -p -t "$TMUX_PANE" '#S').md; mkdir -p "${f%/*}"; exec vim -c 'autocmd TextChanged,InsertLeave,FocusLost <buffer> silent update' "$f"

split -h -l 60%
cpu   | htop

# Above the notes, sized to fit its four lines
split -v -b -l 5 -t notes
info  | watch -t -n 30 'echo "$(whoami)@$(hostname -s)"; uname -srm; uptime | sed "s/^ *//"'

split -v -l 50% -t cpu
disk  | watch -t -n 5 df -h

split -v -l 50%
io    | iostat -w 2
