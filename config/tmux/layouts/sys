# System monitor: info, network, updates and a scratch pad on the left; htop and disk on the right.
#
# Works on macOS and Linux. See ../launch for the layout functions.

set-option pane-border-status top
set-option pane-border-format " #{pane_title} "
# The panes redraw constantly, so activity alerts would always be firing
set-option monitor-activity off

# One notes file per tmux session, saved on every change so notes survive the
# session being killed
notes=${XDG_DATA_HOME:-$HOME/.local/share}/scratchpad/$(tmux display -p -t $win '#S').md
mkdir -p ${notes:h}
split-window -T notes \
    "exec vim -c 'autocmd TextChanged,InsertLeave,FocusLost <buffer> silent update' ${(q)notes}"

# Busiest processes first
if (( $+commands[htop] )); then
    cpu='htop -s PERCENT_CPU'
elif [[ $OSTYPE == darwin* ]]; then
    cpu='top -o cpu'
else
    cpu='top -o %CPU'
fi
split-window -T cpu -h -l 60% $cpu

# Above the notes, each sized to fit its lines
widget sysinfo -t notes -v -b -l 5
widget net -t notes -v -b -l 7
# The count and the first several packages
widget updates -t notes -v -b -l 10

# Room for a few filesystems; htop gets the rest
widget disk -t cpu -v -l 8
