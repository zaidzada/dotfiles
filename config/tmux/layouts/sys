# System monitor: info and a scratch pad on the left; htop, disk and io on the right.
#
# Works on macOS and Linux. See ../launch for the layout functions.

set-option pane-border-status top
set-option pane-border-format " #{pane_title} "

# One notes file per tmux session, saved on every change so notes survive the
# session being killed
notes=${XDG_DATA_HOME:-$HOME/.local/share}/scratchpad/$(tmux display -p -t $win '#S').md
mkdir -p ${notes:h}
split-window -T notes \
    "exec vim -c 'autocmd TextChanged,InsertLeave,FocusLost <buffer> silent update' ${(q)notes}"

(( $+commands[htop] )) && cpu=htop || cpu=top
split-window -T cpu -h -l 60% $cpu

# Above the notes, sized to fit its three lines
split-window -T info -t notes -v -b -l 5 \
    "watch -t -n 30 'echo $USERNAME@${HOST%%.*}; uname -srm; uptime | sed \"s/^ *//\"'"

if [[ $OSTYPE == linux* ]]; then
    # Skip the many pseudo filesystems Linux lists
    disk='df -h -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs'
else
    disk='df -h'
fi
split-window -T disk -t cpu -v -l 50% "watch -t -n 5 $disk"

# iostat flags differ: on macOS -w is the interval; on Linux (sysstat) -d shows
# devices and -y skips the since-boot report. vmstat if sysstat is missing
if [[ $OSTYPE == darwin* ]]; then
    io='iostat -w 2'
elif (( $+commands[iostat] )); then
    io='iostat -dy 2'
else
    io='vmstat 2'
fi
split-window -T io -v -l 50% $io
