" -----------------------------------------------------------------------------
" > Color scheme
" -----------------------------------------------------------------------------

" Follow the macOS light/dark appearance; elsewhere, fall back to time of day
function! s:SetColorscheme() abort
  if executable('defaults')
    let l:dark = system('defaults read -g AppleInterfaceStyle 2>/dev/null') =~? 'dark'
  else
    let l:dark = strftime("%H") < 7 || strftime("%H") >= 18
  endif
  let l:scheme = l:dark ? 'onehalfdark' : 'onehalflight'
  if get(g:, 'colors_name', '') !=# l:scheme
    execute 'colorscheme' l:scheme
  endif
endfunction

call s:SetColorscheme()

augroup appearance
    autocmd!
    autocmd FocusGained * call s:SetColorscheme()
augroup END


" -----------------------------------------------------------------------------
" > Functions
" -----------------------------------------------------------------------------

" Zoom / Restore window.
function! s:ZoomToggle() abort
    if exists('t:zoomed') && t:zoomed
        execute t:zoom_winrestcmd
        let t:zoomed = 0
    else
        let t:zoom_winrestcmd = winrestcmd()
        resize
        vertical resize
        let t:zoomed = 1
    endif
endfunction
command! ZoomToggle call s:ZoomToggle()

nnoremap <silent> <Leader>z :ZoomToggle<CR>


