" Completion (:h ins-completion)
function! CleverTab()
    if strpart( getline('.'), 0, col('.')-1 ) =~ '^\s*$'
        return "\<Tab>"
    else
        return "\<C-X><C-O>"
    endif
endfunction

inoremap <Tab> <C-R>=CleverTab()<CR>

augroup omnicomplete
    autocmd!
    if exists("+omnifunc")
        autocmd Filetype *
            \ if &omnifunc == "" |
            \ setlocal omnifunc=syntaxcomplete#Complete |
            \ endif
    endif
augroup END

" Commenting blocks of code (falls back to '#' for unlisted filetypes)
augroup comment_leader
    autocmd!
    autocmd FileType c,cpp,java,scala     let b:comment_leader = '//'
    autocmd FileType javascript,typescript,go,rust let b:comment_leader = '//'
    autocmd FileType sh,zsh,ruby,python   let b:comment_leader = '#'
    autocmd FileType conf,fstab,yaml,toml let b:comment_leader = '#'
    autocmd FileType lua,sql,haskell      let b:comment_leader = '--'
    autocmd FileType tex                  let b:comment_leader = '%'
    autocmd FileType mail                 let b:comment_leader = '>'
    autocmd FileType vim                  let b:comment_leader = '"'
augroup END
function! CommentToggle()
    let l:leader = escape(get(b:, 'comment_leader', '#'), '\/')
    execute ':silent! s/\([^ ]\)/' . l:leader . ' \1/'
    execute ':silent! s/^\( *\)' . l:leader . ' \?' . l:leader . ' \?/\1/'
endfunction
nnoremap <leader>cc :call CommentToggle()<CR>
vnoremap <leader>cc :call CommentToggle()<CR>

