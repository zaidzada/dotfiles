# User settings
[user]
    name = Zaid Zada
    email = 60576490+zaidzada@users.noreply.github.com

[github]
    user = zaidzada

# Misc settings
[core]
    editor = vim
    # zprofile exports LESS, which stops git adding its default FRX;
    # uncomment to quit on short output again
    # pager = less -FRX

[push]
    default = simple

[color]
    ui = true

[help]
    autocorrect = 1

[init]
    defaultBranch = main

[http]
    sslVerify = true

# -----------------------------------------------------------------------------
# Aliases
# -----------------------------------------------------------------------------

[alias]
    a = add
    b = branch -a
    c = commit
    d = diff
    r = remote -v
    s = status -s
    t = tag -l

    cm = commit -m
    cam = commit -am
    co = checkout
    st = status

    l = log --graph --oneline --decorate -n20
    ll = log --graph --oneline --decorate --branches --tags
    lll = log --graph --oneline --decorate --all
    lgb = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches

