set -e

# convert to tiff
for img in *NEF; do sips -s format tiff "$img" -o "${img%.*}.tiff"; done

# focus stack
/Applications/focus-stack.app/Contents/MacOS/focus-stack --output=stacked.tiff DSC*tiff

# convert to heic
firstName=$(/bin/ls -1 *NEF | head -n1)
sips -s format heic -s formatOptions high stacked.tiff -o "${firstName%.*}_stacked.heic"

# copy metadata to new file
exiftool -tagsFromFile "$firstName" "-all:all>all:all" "${firstName%.*}_stacked.heic"

# if happy, remove temporary files
# rm *tiff *_original
